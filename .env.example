ANTHROPIC_API_KEY=your-anthropic-api-key-here
CLAUDE_MODEL=claude-sonnet-5
STUB_CLAUDE_API=true
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/freshbrain
WAREHOUSE_API_BASE_URL=http://localhost:8002

# Self-issued token signing — see app/dev/router.py's POST /dev/token.
# Generate a real one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your-hs256-shared-secret-here
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=15

# WMS integration — not yet wired in (see tools/functions/inbound.py STUB).
# Fill these in once real WMS access is available, then remove the stub.
WMS_BASE_URL=
WMS_API_KEY=

# Rate limiting only for now — no cache/locks/queue on Redis yet, not a
# rule against it, just not needed until something actually calls for it.
RATE_LIMIT_STORAGE_URI=redis://localhost:6379/0
